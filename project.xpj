[PROJECT]
    TARGET_DIR = .\run
    Version = 3.0
    project.xpj

[project.xpj]
    custaddrsvc.exe

[custaddrsvc.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
    RUNPARAMETER         = -exe
    POST_BUILD           = - copy custaddrsvc.exe.config $(TARGET_PATH)
    DEPENDS_ON           = $(ASSETS_PATH)\configuration-manager@0.9
    DEPENDS_ON           = $(ASSETS_PATH)\console-helper@0.14
    DEPENDS_ON           = $(ASSETS_PATH)\microservice-core@0.21
    DEPENDS_ON           = $(ASSETS_PATH)\rest-helper@0.21
    DEPENDS_ON           = $(ASSETS_PATH)\jwt-helper@1.3
// $START-AUTODEPEND
    cust-addr-svc-main.obj
    cust-addr-svc-microservice.obj
    customer-address-handler.obj
// $STOP-AUTODEPEND
    custaddrsvc.exe.config
    cust-addr-svc-main.prg
    cust-addr-svc-microservice.prg
    customer-address-handler.prg
    version.arc

